{
  "name": "finance-dash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"DOTENV_CONFIG_PATH=.env.local tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "server": "DOTENV_CONFIG_PATH=.env.local tsx watch server/index.ts",
    "auth:configure:slash": "tsx scripts/configure-auth.ts",
    "auth:configure:transaction-reviewer": "tsx scripts/configure-transaction-reviewer.ts",
    "import:management-report": "tsx scripts/import-management-report.ts",
    "import:wise-statements": "tsx scripts/import-wise-statements.ts",
    "save:cash-flow-snapshot": "tsx scripts/save-cash-flow-snapshot.ts",
    "wise:reset": "tsx scripts/reset-wise.ts",
    "revolut:setup": "tsx scripts/setup-revolut.ts",
    "ledger:cutover": "tsx scripts/migrate-bank-ledger.ts",
    "ledger:verify": "tsx scripts/verify-bank-ledger.ts",
    "build": "tsc -b && vite build",
    "convex:dev": "convex dev --once --env-file .env.local",
    "test": "tsx --test server/*.test.ts shared/*.test.ts worker/*.test.ts",
    "check": "npm run lint && npm test && npm run build",
    "deploy:convex": "npm run convex:dev",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "deploy": "npm run build && npm run deploy:convex && npm run ledger:verify && wrangler deploy",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "tsc -b --pretty false"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@tailwindcss/vite": "^4.3.2",
    "@vitejs/plugin-react": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "convex": "^1.41.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "lucide-react": "^0.562.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "read-excel-file": "^9.3.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "wrangler": "^4.125.0"
  },
  "overrides": {
    "ws": "8.21.0"
  }
}
