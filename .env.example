# App
PORT=8787
VITE_API_BASE=/api
VITE_CONVEX_URL=https://fabulous-elephant-597.convex.cloud
CONVEX_URL=https://fabulous-elephant-597.convex.cloud
CONVEX_DEPLOYMENT=dev:fabulous-elephant-597
CONVEX_SERVICE_TOKEN=
# Cutover-only, explicit disposition after a verified data backup. Leave empty during normal operation.
BANK_LEDGER_LEGACY_DISPOSITION=
# Cutover-only, explicit disposal of team metadata whose transaction no longer exists. Leave empty during normal operation.
BANK_LEDGER_ORPHAN_ASSIGNMENT_DISPOSITION=
# Server-only write token for management workbook imports; never expose through Vite or Worker responses.
MANAGEMENT_REPORT_IMPORT_TOKEN=

# Main dashboard Telegram OTP authentication. Store production values as Cloudflare Worker secrets;
# never copy real values into this file. TELEGRAM_AUTH_USERS_JSON maps login usernames to private chat IDs.
AUTH_SESSION_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_USERS_JSON=
# Additional credential accepted only by slash.thatcanadian.dev. Configure production values with
# `npm run auth:configure:slash`; do not copy real values into this file.
SLASH_AUTH_USERNAME=
SLASH_AUTH_PASSWORD_HASH=

# OpenRouter AI
# Keep this in the runtime environment; it is never stored in dashboard state.
OPENROUTER_API_KEY=

# Wise Platform
# Docs: https://docs.wise.com/
# The token lists accessible businesses; WISE_PROFILE_IDS selects which ones to sync.
WISE_API_TOKEN=
# Stable operator-assigned ID for this bank connection; never change when rotating credentials or accounts.
WISE_CONNECTION_ID=primary
# Comma-separated business profile IDs to include in the dashboard.
WISE_PROFILE_IDS=
WISE_ENVIRONMENT=production

# Revolut Business API
# Setup: docs/revolut-setup.md
REVOLUT_ENVIRONMENT=production
REVOLUT_CONNECTION_ID=primary
REVOLUT_CLIENT_ID=
REVOLUT_ISSUER=finance.thatcanadian.dev
REVOLUT_PRIVATE_KEY_PEM=
REVOLUT_REFRESH_TOKEN=

# Slash beta API (dashboard-created keys are user-scoped)
# Docs: https://docs.slash.com/
SLASH_API_KEY=
SLASH_CONNECTION_ID=primary
# Required x-legal-entity header value for the user-scoped key above.
SLASH_LEGAL_ENTITY_ID=
SLASH_BASE_URL=https://api.slash.com

# American Express Account and Transaction API
# Docs: https://developer.americanexpress.com/products/account-and-transaction-api-public/overview
AMEX_TOKEN_URL=
AMEX_CONNECTION_ID=
AMEX_API_BASE_URL=
AMEX_CLIENT_ID=
AMEX_CLIENT_SECRET=
AMEX_REFRESH_TOKEN=
# Comma-separated accountId:name:currency entries, for example: acct_123:Amex Platinum:USD
AMEX_ACCOUNT_IDS=
AMEX_ACCOUNT_PATH_TEMPLATE=
AMEX_TRANSACTIONS_PATH_TEMPLATE=
# Required provider-specific pagination contract. Paths are dot-separated JSON response paths (or $ for a root array).
AMEX_TRANSACTIONS_ITEMS_PATH=
AMEX_TRANSACTIONS_NEXT_CURSOR_PATH=
AMEX_TRANSACTIONS_CURSOR_PARAM=
AMEX_TRANSACTIONS_PAGE_SIZE_PARAM=
# Required integer from 1 through 200. This is sent on every provider request.
AMEX_TRANSACTIONS_PAGE_SIZE=200

# Merit invoices
# Docs: https://api.merit.ee/connecting-robots/reference-manual/
MERIT_API_BASE_URL=https://aktiva.merit.ee/api
MERIT_GET_INVOICES_PATH=/v1/getinvoices
MERIT_CREATE_INVOICE_PATH=/v2/sendinvoice
MERIT_DELIVER_INVOICE_PATH=/v2/sendinvoicebyemail
MERIT_API_ID=
MERIT_API_KEY=
# Hard safety gate. Set true only when explicit, user-confirmed invoice sending is approved.
MERIT_WRITES_ENABLED=false
MERIT_DEFAULT_ITEM_CODE=SERVICES
MERIT_DEFAULT_COUNTRY_CODE=EE

# Partner revenue and invoice automation
# TUNE Affiliate API / HasOffers: https://developers.tune.com/affiliate
REVENUE_TIMEZONE=Asia/Beirut
KISSTERRA_TUNE_NETWORK_ID=
KISSTERRA_TUNE_API_KEY=
# Optional override. Defaults to https://{networkId}.api.hasoffers.com/Apiv3/json
KISSTERRA_TUNE_API_BASE_URL=

# Approximate USD conversion
# Coinbase's keyless spot-price API; native-currency totals remain the source of truth.
COINBASE_SPOT_PRICES_URL=https://api.coinbase.com/v2/prices
